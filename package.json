{
	"name": "rawsens",
	"version": "0.0.0",
	"private": true,
	"description": "Open-source aim sensitivity calibration for Windows and macOS.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"imports": {
		"#app/components/*": "./src/components/*.tsx",
		"#app/hooks/*": "./src/hooks/*.ts",
		"#app/lib/*": "./src/lib/*.ts"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"scripts": {
		"build:desktop": "pnpm build:input-helper && pnpm electrobun:prepare && pnpm build:web && electrobun build --env=stable",
		"build:desktop:dev": "pnpm build:input-helper && pnpm electrobun:prepare && pnpm build:web && electrobun build --env=dev",
		"build:input-helper": "node --experimental-strip-types scripts/build-input-helper.ts",
		"build:web": "vite build",
		"changeset": "changeset",
		"check": "pnpm electrobun:prepare && pnpm lint && pnpm typecheck && pnpm test && pnpm build:web",
		"dev": "pnpm build:input-helper && pnpm electrobun:prepare && concurrently --kill-others-on-fail \"vite --port 5173\" \"wait-on http://127.0.0.1:5173 && electrobun dev --watch\"",
		"electrobun:prepare": "electrobun prepare",
		"format": "biome check --write .",
		"lint": "biome check .",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"version-packages": "changeset version"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.0",
		"@hugeicons/react": "^1.1.10",
		"@tanstack/react-router": "1.170.31",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"shadcn": "^4.19.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@changesets/cli": "3.0.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "1.3.11",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.1.0",
		"concurrently": "10.0.5",
		"electrobun": "2.0.1",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "8.2.2",
		"wait-on": "9.0.4"
	}
}
